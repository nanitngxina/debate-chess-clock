{
  "name": "debate-chess-clock",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local --port 8787",
    "build": "tsc && vite build",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "check": "tsc && tsc -p tsconfig.worker.json",
    "check:render": "esbuild scripts/render-check.tsx --bundle --platform=node --format=cjs --outfile=.render-check.cjs --jsx=automatic --loader:.css=empty --define:import.meta.env={} && node .render-check.cjs",
    "check:all": "npm run check && npm run check:render",
    "deploy": "npx wrangler deploy",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "wrangler": "^4.82.2"
  }
}
